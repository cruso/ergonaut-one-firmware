/*
 * Ergonaut One — adapted from thrly-corne-zmk
 * 42-key programmer-focused layout
 *
 * Features:
 * - QWERTY
 * - Homerow mods
 * - Symbol layer
 * - Navigation layer
 * - Number layer
 * - Thumb-friendly layout
 * - Works for Vim / IDE / terminal workflow
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define NUM 3
#define FUN 4

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
/* ------------------------------------------------- LEFT ------------------------------------------------- */
/* ROW 1 */
&kp Q            &kp W            &kp E            &kp R            &kp T                 &kp Y            &kp U            &kp I            &kp O            &kp P
/* ROW 2 */
&mt LCTRL A      &mt LALT S       &mt LGUI D       &mt LSFT F       &kp G                 &kp H            &mt RSFT J       &mt RGUI K       &mt RALT L       &mt RCTRL SEMI
/* ROW 3 */
&kp Z            &kp X            &kp C            &kp V            &kp B                 &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH
/* THUMBS */
                                  &mo NAV          &kp SPACE        &kp TAB               &kp ENTER        &mo SYM          &kp BSPC
            >;

            sensor-bindings = <>;
        };

        nav_layer {

            bindings = <
/* ------------------------------------------------- LEFT ------------------------------------------------- */
&trans           &trans           &trans           &trans           &trans                &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &trans
&trans           &kp LALT         &kp LGUI         &kp LSFT         &trans                &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &trans
&trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &trans

                                  &trans           &trans           &trans                &trans           &trans           &trans
            >;
        };

        sym_layer {

            bindings = <
/* ------------------------------------------------- LEFT ------------------------------------------------- */
&kp EXCL         &kp AT           &kp HASH         &kp DLLR         &kp PRCNT             &kp AMPS         &kp STAR         &kp LBRC         &kp RBRC         &kp PIPE
&kp GRAVE        &kp TILDE        &kp CARET        &kp PLUS         &kp EQUAL             &kp LEFT_PAREN   &kp RIGHT_PAREN  &kp LCURBR       &kp RCURBR       &kp BSLH
&kp LT           &kp GT           &kp MINUS        &kp UNDER        &kp COLON             &kp SEMI         &kp DQT          &kp SQT          &kp QUESTION     &trans

                                  &trans           &trans           &trans                &trans           &trans           &trans
            >;
        };

        num_layer {

            bindings = <
/* ------------------------------------------------- LEFT ------------------------------------------------- */
&trans           &trans           &trans           &trans           &trans                &kp N7           &kp N8           &kp N9           &kp KP_MINUS     &trans
&trans           &trans           &trans           &trans           &trans                &kp N4           &kp N5           &kp N6           &kp KP_PLUS      &trans
&trans           &trans           &trans           &trans           &trans                &kp N1           &kp N2           &kp N3           &kp N0           &trans

                                  &trans           &trans           &trans                &trans           &trans           &trans
            >;
        };

        fun_layer {

            bindings = <
/* ------------------------------------------------- LEFT ------------------------------------------------- */
&kp F1           &kp F2           &kp F3           &kp F4           &kp F5                &kp F6           &kp F7           &kp F8           &kp F9           &kp F10
&trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &kp F11
&trans           &trans           &trans           &trans           &trans                &trans           &trans           &trans           &trans           &kp F12

                                  &trans           &trans           &trans                &trans           &trans           &trans
            >;
        };
    };

    combos {

        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <30>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <30>;
            key-positions = <8 9>;
            bindings = <&kp TAB>;
        };

        combo_caps {
            timeout-ms = <30>;
            key-positions = <10 11>;
            bindings = <&caps_word>;
        };
    };
};