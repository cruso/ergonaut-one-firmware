/*
 * Ergonaut One — upgraded programmer layout
 * Inspired by thrly-corne-zmk
 *
 * Goals:
 * - Keep your current muscle memory
 * - Improve programming ergonomics
 * - Better symbols placement
 * - Cleaner navigation workflow
 * - Preserve tri-layer setup
 * - Safe migration path
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define SYM 1
#define NAV 2
#define ADJ 3

&lt { quick-tap-ms = <200>; };

&mt { quick-tap-ms = <200>; };

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <SYM NAV>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =========================================================
         * DEFAULT
         * ========================================================= */

        default_layer {
            display-name = "BASE";
            bindings = <
&mt LGUI RBKT    &kp Q  &kp W  &kp E        &kp R            &lt 3 T      &lt 3 Y      &kp U           &kp I        &kp O    &kp P     &kp LBKT
&mt LCTRL GRAVE  &kp A  &kp S  &kp D        &kp F            &kp G        &kp H        &kp J           &kp K        &kp L    &kp SEMI  &mt RCTRL SQT
&mt LALT MINUS   &kp Z  &kp X  &kp C        &kp V            &kp B        &kp N        &kp M           &kp COMMA    &kp DOT  &kp FSLH  &mt RALT BSLH
                               &lt NAV TAB  &mt LSHFT SPACE  &lt SYM RET  &lt SYM ESC  &mt RSHFT BSPC  &lt NAV DEL
            >;
        };

        /* =========================================================
         * SYMBOLS / PROGRAMMING
         * ========================================================= */

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PRCNT  &kp AMPS    &kp PIPE    &kp LBKT    &kp RBKT          &kp TILDE  &kp BSLH
&kp TAB    &kp LPAR  &kp RPAR  &kp LBRC  &kp RBRC   &kp CARET  &kp RA(N1)  &kp RA(N2)  &kp RA(N3)  &kp RA(NUMBER_4)  &kp COLON  &kp DQT
&kp ESC    &kp LT    &kp GT    &kp PLUS  &kp MINUS  &kp EQUAL  &kp UNDER   &kp STAR    &kp FSLH    &kp SEMI          &kp SQT    &kp RET
                               &trans    &trans     &trans     &trans      &trans      &trans
            >;
        };

        /* =========================================================
         * NAVIGATION / NUMPAD
         * ========================================================= */

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5       &kp F6        &kp HOME    &kp PG_DN     &kp PG_UP     &kp END          &kp PSCRN  &kp INS
&kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &kp CAPS     &kp TAB       &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT        &kp DEL    &kp K_APP
&kp ESC    &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS  &kp KP_MINUS  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp PAUSE_BREAK  &kp SLCK   &kp CLCK
                                 &trans     &trans       &trans        &trans      &trans        &trans
            >;
        };

        /* =========================================================
         * ADJUST / SYSTEM
         * ========================================================= */

        adjust_layer {
            display-name = "ADJ";
            bindings = <
&bootloader  &studio_unlock  &none         &none         &none         &none         &none         &none         &none         &none         &studio_unlock  &bootloader
&bt BT_CLR   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0    &bt BT_CLR
&sys_reset   &none           &none         &none         &none         &none         &none         &none         &none         &none         &none           &sys_reset
                                           &trans        &none         &trans        &none         &trans        &trans
            >;
        };
    };

    /* =========================================================
     * COMBOS
     * ========================================================= */

    combos {
        compatible = "zmk,combos";

        combo_caps_word {
            timeout-ms = <40>;
            key-positions = <14 15>;
            bindings = <&caps_word>;
        };

        combo_escape {
            timeout-ms = <30>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <30>;
            key-positions = <8 9>;
            bindings = <&kp TAB>;
        };
    };
};
